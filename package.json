    "dotenv": "^18.0.10",
    "genius-lyrics": "^4.4.7",
    "glob": "^14.0.4",
    "shoukaku": "4.3.0",
    "spotify-url-info": "^3.3.3",
    "tslib": "^2.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^26",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
